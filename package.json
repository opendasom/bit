{
  "name": "bit",
  "type": "module",
  "scripts": {
    "anvil:seed": "node contracts/scripts/seed-anvil.mjs",
    "compile": "node contracts/scripts/compile-contract.mjs",
    "format:check": "prettier --check web/src vite.config.ts contracts/scripts/*.mjs package.json .prettierrc.json",
    "test:web": "vitest run",
